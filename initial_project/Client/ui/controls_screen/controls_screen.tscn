[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://ui/controls_screen/controls_screen.gd" id="1_script"]
[ext_resource type="Texture2D" path="res://ui/controls_screen/images/controller_layout.png" id="2_controller"]
[ext_resource type="Theme" path="res://ui/shared/navigation_theme.tres" id="3_theme"]
[ext_resource type="Texture2D" path="res://ui/shared/icons/go-back-arrow.png" id="4_back"]

[node name="ControlsScreen" type="Control"]
visible = false
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
script = ExtResource("1_script")
theme = ExtResource("3_theme")

[node name="Backdrop" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 0
color = Color(0, 0.01, 0.03, 0.88)

[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="PanelContainer" type="PanelContainer" parent="CenterContainer"]
custom_minimum_size = Vector2(820, 560)
layout_mode = 2
theme_type_variation = &"NavigationSurface"

[node name="MarginContainer" type="MarginContainer" parent="CenterContainer/PanelContainer"]
layout_mode = 2
