[sub_resource type="Shader" id="IconMaskShader"]
code = "shader_type canvas_item;

uniform vec4 icon_color : source_color = vec4(1.0);

void fragment() {
	float mask = texture(TEXTURE, UV).r;
	COLOR = vec4(icon_color.rgb, icon_color.a * mask);
}
"

