[sub_resource type="Shader" id="LogoFadeShader"]
code = "shader_type canvas_item;

void fragment() {
	const float aspect_ratio = 3.25;
	vec2 point = (UV - vec2(0.5)) * vec2(aspect_ratio, 1.0);
	vec2 half_size = vec2(aspect_ratio * 0.5, 0.5);
	float radius = 0.12;
	vec2 rounded = abs(point) - (half_size - vec2(radius));
	float distance_to_shape = length(max(rounded, vec2(0.0))) + min(max(rounded.x, rounded.y), 0.0) - radius;
	float rounded_alpha = 1.0 - smoothstep(-0.006, 0.006, distance_to_shape);

	float horizontal_distance = abs(UV.x - 0.5) * 2.0;
	float center_light = 1.0 - smoothstep(0.08, 1.0, horizontal_distance);
	center_light = pow(center_light, 0.55);
	vec3 edge_color = vec3(0.12, 0.23, 0.34);
	vec3 center_color = vec3(0.97, 0.98, 0.99);
	vec3 card_color = mix(edge_color, center_color, center_light);

	COLOR = vec4(card_color, 0.97 * rounded_alpha);
}
"

[sub_resource type="ShaderMaterial" id="LogoFadeMaterial"]
shader = SubResource("LogoFadeShader")

